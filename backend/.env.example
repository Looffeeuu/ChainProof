# Fabric 连接配置
# 复制为 .env 后按实际环境修改

# Peer 地址（Fabric 运行在本机时 localhost，运行在 VM 时填 VM IP）
PEER_ENDPOINT=localhost:7051
# Peer TLS 主机名覆盖
PEER_TLS_HOSTNAME_OVERRIDE=peer0.org1.example.com
# Orderer 地址
ORDERER_ENDPOINT=localhost:7050
ORDERER_TLS_HOSTNAME_OVERRIDE=orderer.example.com

# 通道与链码
CHANNEL_NAME=chainproof
CHAINCODE_NAME=chainproof

# Org1 身份
MSP_ID=Org1MSP
# 以下路径指向 fabric-samples/test-network/organizations/ 下的文件
CERT_PATH=./crypto/org1-cert.pem
KEY_PATH=./crypto/org1-key.pem
TLS_CERT_PATH=./crypto/org1-tls-ca.crt

# 上传文件存储目录
UPLOAD_DIR=./uploads

# 服务端口
PORT=3000
