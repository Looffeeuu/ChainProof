# ChainProof 本地 Fabric 网络配置
#
# 本文件被 chainproof-network.sh 与 scripts/ 下的子脚本 source。
# 所有值都可以用同名环境变量覆盖，例如：
#   FABRIC_SAMPLES_DIR=/data/fabric-samples ./chainproof-network.sh up
#
# 版本一律在此处固定，不要在命令行里临时指定，否则三个组员的环境会漂移。
# 详见 README.md「版本固定」一节。

# fabric-samples 的 envVar.sh 在 set -u 下会直接读取这两个变量。
# 给子脚本统一默认值，调用者无需额外加 OVERRIDE_ORG/VERBOSE 前缀。
export OVERRIDE_ORG="${OVERRIDE_ORG:-}"
export VERBOSE="${VERBOSE:-false}"

# ---------------------------------------------------------------------------
# Fabric 版本（固定值，改动需同步 README 与全员）
# ---------------------------------------------------------------------------

# Fabric 组件与 Docker 镜像版本。
# 这是真正决定链上行为的版本：二进制（peer/orderer/...）与 Docker 镜像都按它下载。
# 已验证：v2.5.16 的 linux-amd64 二进制下载地址返回 HTTP 200，镜像 manifest 可拉取。
export FABRIC_VERSION="2.5.16"
# Fabric CA 版本（已验证下载地址 HTTP 200）
export FABRIC_CA_VERSION="1.5.17"

# fabric-samples 的 git ref（分支名 / tag / commit sha 均可）。
#
# 注意（实测结论，容易踩坑）：
#   fabric-samples 仓库【没有】v2.5.x 的 tag，最新 tag 只到 v2.4.9。
#   它的版本号与 Fabric 本体并不同步，因此不能写成 FABRIC_SAMPLES_REF="v${FABRIC_VERSION}"
#   —— 那样 clone/checkout 会失败（codeload 对 v2.5.16 返回 HTTP 404）。
#   官方 install-fabric.sh 的行为也是：找不到对应 tag 时回落到 main。
#
# 默认用 main（跟随官方回落行为），并由 install-fabric.sh 下载与 FABRIC_VERSION
# 严格对齐的二进制与镜像，因此 samples 的 ref 不影响链上版本。
export FABRIC_SAMPLES_REF="${FABRIC_SAMPLES_REF:-main}"

# 已通过本项目实测验证的 samples commit（如需完全复现成员 B 的环境可显式指定）：
#   FABRIC_SAMPLES_REF=d999452 ./chainproof-network.sh setup
# 该 commit 对应 main 分支 v2.4.0-201-gd999452。
export CHAINPROOF_VERIFIED_SAMPLES_COMMIT="d999452"

# ---------------------------------------------------------------------------
# 通道与链码（与 docs/ARCHITECTURE.md、docs/API.md 约定一致）
# ---------------------------------------------------------------------------

export CHANNEL_NAME="chainproof"
export CC_NAME="chainproof"
export CC_SRC_LANGUAGE="javascript"
export CC_VERSION="1.1"
export CC_SEQUENCE="2"

# 状态数据库：leveldb 即可。
# 本仓库链码只使用 getState / putState / getStateByRange /
# getStateByPartialCompositeKey / getHistoryForKey，
# 全部属于 leveldb 支持的操作，没有用到 CouchDB 的 rich query，
# 因此不需要 -s couchdb（切到 CouchDB 只会增加内存占用与启动时间）。
export DATABASE="leveldb"

# ---------------------------------------------------------------------------
# 路径
# ---------------------------------------------------------------------------

# fabric-samples 的存放位置。
# 默认 $HOME/fabric-samples；如果本机已有 fabric-samples，
# 用环境变量指向它即可复用，避免重新下载约 1.4 GB 镜像与样例：
#   FABRIC_SAMPLES_DIR=/home/you/hyperledger/fabric/scripts/fabric-samples ./chainproof-network.sh up
export FABRIC_SAMPLES_DIR="${FABRIC_SAMPLES_DIR:-$HOME/fabric-samples}"

# test-network 目录（由 FABRIC_SAMPLES_DIR 推导）
export TEST_NETWORK_DIR="${FABRIC_SAMPLES_DIR}/test-network"

# 仓库根目录：本文件位于 <repo>/blockchain/network/config.env，向上两级即仓库根。
# 用 bash 的 BASH_SOURCE 推导，保证从任意工作目录调用都正确。
_CHAINPROOF_NETWORK_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export CHAINPROOF_REPO_DIR="$(cd "${_CHAINPROOF_NETWORK_DIR}/../.." && pwd)"

# 仓库内的链码源码目录
export CHAINCODE_SRC_DIR="${CHAINPROOF_REPO_DIR}/blockchain/chaincode"

# 链码部署时使用的暂存目录。
#
# 为什么需要暂存而不是直接用 CHAINCODE_SRC_DIR：
#   在 Windows + WSL2 环境下，仓库通常位于 /mnt/c 或 /mnt/e 这类 Windows 挂载路径。
#   这类路径由 9P 协议提供服务，存在三个问题：
#     1. peer 打包链码时的文件遍历非常慢；
#     2. Docker 容器挂载 Windows 路径时可能出现权限或符号链接异常；
#     3. npm install 在 9P 挂载上极慢，且 node_modules 里的可执行位可能丢失。
#   因此脚本默认把链码复制到 Linux 原生文件系统再打包。
#   纯 Linux/macOS 环境下这一步几乎无成本，同样适用。
export CHAINCODE_STAGE_DIR="${CHAINCODE_STAGE_DIR:-$HOME/.chainproof/chaincode}"

# ---------------------------------------------------------------------------
# 运行参数
# ---------------------------------------------------------------------------

# network.sh 的重试次数与间隔
export MAX_RETRY="10"
export CLI_DELAY="3"

# 冒烟测试用的演示数据（与 docs/API.md 的示例保持一致）
export SMOKE_PROJECT_ID="P001"
export SMOKE_MEMBER_IDS='["alice","bob","charlie"]'

# ---------------------------------------------------------------------------
# 供后端使用的连接信息（成员 C 接 Fabric Gateway 时会用到）
# ---------------------------------------------------------------------------

export PEER0_ORG1_ADDRESS="localhost:7051"
export PEER0_ORG2_ADDRESS="localhost:9051"
export ORDERER_ADDRESS="localhost:7050"
